{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/server.ts",
		"start": "NODE_ENV=production bun src/server.ts",
		"build": "bun run build.ts",
		"db:migrate": "bun run src/lib/migrate.ts",
		"db:migrate:dev": "NODE_ENV=development bun run src/lib/migrate.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.51",
		"@better-auth/telemetry": "^1.7.4",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@tabler/icons-react": "^3.46.0",
		"ai": "^7.0.105",
		"better-auth": "^1.7.4",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"kysely": "^0.29.5",
		"kysely-postgres-js": "^4.0.0",
		"postgres": "^3.4.9",
		"radix-ui": "^1.6.7",
		"react": "^19",
		"react-dom": "^19",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.1.11"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
