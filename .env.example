# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Better Auth
BETTER_AUTH_SECRET=your-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@example.com

# Bun S3 (S3-совместимое хранилище)
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.us-east-2.amazonaws.com
S3_BUCKET=images
S3_REGION=us-east-2

# Ежедневная выдача кредитов (крон): Vercel шлёт секрет как Bearer в /api/cron/daily-credits
CRON_SECRET=

# LLM обогащения промпта (Inception, необязательные)
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3

# Braintrust (трассировка и evaluation; ключ обязателен — без него работа невозможна)
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=Gen42
